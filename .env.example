# Copy this file to .env and fill in your values.
# NEVER commit .env to git. NEVER share your private key.

# Your wallet private key (without 0x prefix)
PRIVATE_KEY=your_private_key_here

# Sepolia RPC URL — get one free from Alchemy or Infura
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/your_api_key_here

# Etherscan API key — for contract verification
ETHERSCAN_API_KEY=your_etherscan_api_key_here

# The wallet address that will act as game master (can be same as deployer for testing)
GAME_MASTER_ADDRESS=your_game_master_address_here
